<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sesion_view_tree" model="ir.ui.view">
        <field name="name">academia.sesion.tree</field>
        <field name="model">academia.sesion</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="curso_id"/>
                <field name="instructor_id"/>
                <field name="fecha"/>
                <field name="duracion" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="sesion_view_form" model="ir.ui.view">
        <field name="name">academia.sesion.form</field>
        <field name="model">academia.sesion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="curso_id"/>
                            <field name="instructor_id"/>
                        </group>
                        <group>
                            <field name="fecha"/>
                            <field name="duracion"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sesion_view_calendar" model="ir.ui.view">
        <field name="name">academia.sesion.calendar</field>
        <field name="model">academia.sesion</field>
        <field name="arch" type="xml">
            <calendar string="Sesiones" date_start="fecha" date_delay="duracion"
                      color="curso_id" mode="week">
                <field name="name"/>
                <field name="curso_id"/>
            </calendar>
        </field>
    </record>

    <record id="sesion_action" model="ir.actions.act_window">
        <field name="name">Sesiones</field>
        <field name="res_model">academia.sesion</field>
        <field name="view_mode">calendar,tree,form</field>
    </record>
</odoo>
