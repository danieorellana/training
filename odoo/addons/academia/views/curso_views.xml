<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         VISTA TREE (lista). En Odoo 18 la etiqueta es <list>.
         ============================================================ -->
    <record id="curso_view_tree" model="ir.ui.view">
        <field name="name">academia.curso.tree</field>
        <field name="model">academia.curso</field>
        <field name="arch" type="xml">
            <tree decoration-muted="estado == 'terminado'" decoration-info="estado == 'borrador'">
                <field name="name"/>
                <field name="instructor_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="horas" sum="Total de horas"/>
                <field name="total_alumnos"/>
                <field name="estado" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================
         VISTA FORM: header con botones, smart button, notebook
         ============================================================ -->
    <record id="curso_view_form" model="ir.ui.view">
        <field name="name">academia.curso.form</field>
        <field name="model">academia.curso</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- type="object": llama al método Python del mismo nombre -->
                    <!-- Odoo 15: "attrs" con un dominio para invisible/readonly/required.
                         (El atributo states="..." solo sirve si el campo se llama "state";
                         aquí el campo se llama "estado", por eso usamos attrs.) -->
                    <button name="action_confirmar" type="object" string="Confirmar"
                            class="btn-primary"
                            attrs="{'invisible': [('estado', '!=', 'borrador')]}"/>
                    <button name="action_terminar" type="object" string="Terminar"
                            class="btn-primary"
                            attrs="{'invisible': [('estado', '!=', 'confirmado')]}"/>
                    <button name="action_borrador" type="object" string="Volver a borrador"
                            attrs="{'invisible': [('estado', '=', 'borrador')]}"
                            groups="academia.group_academia_admin"/>
                    <button name="action_crear_sesion" type="object" string="Crear sesión"
                            attrs="{'invisible': [('estado', '=', 'terminado')]}"/>
                    <button name="action_eliminar_sesiones" type="object" string="Eliminar sesiones"
                            attrs="{'invisible': [('sesion_count', '=', 0)]}"
                            confirm="¿Eliminar todas las sesiones de este curso?"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_sesiones" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="sesion_count" widget="statinfo" string="Sesiones"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej. Odoo básico"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="instructor_id"/>
                            <field name="responsable_id"/>
                            <field name="horas" attrs="{'readonly': [('estado', '=', 'terminado')]}"/>
                        </group>
                        <group>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                            <field name="total_alumnos"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sesiones" name="sesiones">
                            <!-- One2many editable en línea -->
                            <field name="sesion_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="fecha"/>
                                    <field name="duracion" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Temario" >
                            <field name="temario_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="descripcion"/>
                                </tree>
                            </field>

                        </page>
                        <page string="Alumnos" name="alumnos">
                            <!-- Many2many -->
                            <field name="alumno_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Descripción" name="descripcion">
                            <field name="descripcion" placeholder="Temario del curso..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         VISTA KANBAN: tarjetas agrupadas por estado
         (en Odoo 18 la plantilla se llama "card")
         ============================================================ -->
    <record id="curso_view_kanban" model="ir.ui.view">
        <field name="name">academia.curso.kanban</field>
        <field name="model">academia.curso</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" class="o_kanban_small_column">
                <field name="color"/>
                <field name="name"/>
                <field name="instructor_id"/>
                <field name="horas"/>
                <field name="total_alumnos"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click #{kanban_color(record.color.raw_value)}">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div t-if="record.instructor_id.value">
                                    Instructor: <field name="instructor_id"/>
                                </div>
                                <div>
                                    <field name="horas"/> h ·
                                    <field name="total_alumnos"/> alumnos
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================
         VISTA SEARCH: campos, filtros y agrupaciones
         ============================================================ -->
    <record id="curso_view_search" model="ir.ui.view">
        <field name="name">academia.curso.search</field>
        <field name="model">academia.curso</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="instructor_id"/>
                <field name="alumno_ids"/>
                <filter name="mis_cursos" string="Mis cursos"
                        domain="[('responsable_id', '=', uid)]"/>
                <separator/>
                <filter name="borrador" string="Borrador" domain="[('estado', '=', 'borrador')]"/>
                <filter name="confirmado" string="Confirmado" domain="[('estado', '=', 'confirmado')]"/>
                <filter name="terminado" string="Terminado" domain="[('estado', '=', 'terminado')]"/>
                <separator/>
                <filter name="largos" string="Más de 10 horas" domain="[('horas', '>', 10)]"/>
                <filter name="archivados" string="Archivados" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_instructor" string="Instructor"
                            context="{'group_by': 'instructor_id'}"/>
                    <filter name="group_estado" string="Estado"
                            context="{'group_by': 'estado'}"/>
                    <filter name="group_mes" string="Mes de inicio"
                            context="{'group_by': 'fecha_inicio:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         VISTA CALENDAR: cursos sobre sus fechas
         ============================================================ -->
    <record id="curso_view_calendar" model="ir.ui.view">
        <field name="name">academia.curso.calendar</field>
        <field name="model">academia.curso</field>
        <field name="arch" type="xml">
            <calendar string="Cursos" date_start="fecha_inicio" date_stop="fecha_fin"
                      color="instructor_id" mode="month" quick_add="False">
                <field name="name"/>
                <field name="instructor_id"/>
            </calendar>
        </field>
    </record>

    <!-- ============================================================
         VISTA GRAPH: alumnos por instructor
         ============================================================ -->
    <record id="curso_view_graph" model="ir.ui.view">
        <field name="name">academia.curso.graph</field>
        <field name="model">academia.curso</field>
        <field name="arch" type="xml">
            <graph string="Alumnos por instructor" type="bar">
                <field name="instructor_id"/>
                <field name="total_alumnos" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================
         ACCIÓN DE VENTANA: une el modelo con sus vistas
         ============================================================ -->
    <record id="curso_action" model="ir.actions.act_window">
        <field name="name">Cursos</field>
        <field name="res_model">academia.curso</field>
        <field name="view_mode">tree,kanban,form,calendar,graph</field>
        <field name="search_view_id" ref="curso_view_search"/>
        <field name="context">{'search_default_mis_cursos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primer curso</p>
            <p>Los cursos agrupan sesiones, instructores y alumnos.</p>
        </field>
    </record>
</odoo>
