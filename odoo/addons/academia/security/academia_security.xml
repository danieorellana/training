<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categoría: agrupa los grupos del módulo en Ajustes > Usuarios -->
    <record id="module_category_academia" model="ir.module.category">
        <field name="name">Academia</field>
        <field name="sequence">50</field>
    </record>

    <!-- GRUPOS (res.groups) -->
    <record id="group_academia_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_academia"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_academia_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_academia"/>
        <!-- Un administrador también tiene todos los permisos de usuario -->
        <field name="implied_ids" eval="[(4, ref('group_academia_usuario'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- REGLAS DE REGISTRO (ir.rule): qué registros ve cada grupo -->
    <record id="rule_curso_usuario" model="ir.rule">
        <field name="name">Curso: el usuario solo ve sus cursos</field>
        <field name="model_id" ref="model_academia_curso"/>
        <field name="domain_force">[('responsable_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_academia_usuario'))]"/>
    </record>

    <record id="rule_curso_admin" model="ir.rule">
        <field name="name">Curso: el administrador ve todos</field>
        <field name="model_id" ref="model_academia_curso"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_academia_admin'))]"/>
    </record>
</odoo>
